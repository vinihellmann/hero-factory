{
  "name": "@hero-factory/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/server.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@hero-factory/contracts": "*",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.4",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "mariadb": "3.5.4",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/mysql": "12.2.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "pino-pretty": "13.1.3",
    "vitest": "5.0.2"
  }
}
